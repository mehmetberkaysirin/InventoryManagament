@model InventoryManagement.Application.DTOs.Categories.CategoryUpdateDto

@{
    ViewData["Title"] = "Kategori Düzenle";
}

<div class="row">
    <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
        <div class="card card-warning card-outline shadow-sm">

            <div class="card-header">
                <h3 class="card-title fw-bold">
                    <i class="fa-solid fa-pen-to-square me-2"></i>Kategori Bilgilerini Güncelle
                </h3>
            </div>

            <form asp-action="Edit" method="post">
                <input asp-for="Id" type="hidden" />

                <div class="card-body">

                    <!-- Kategori Adı -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Kategori Adı</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-layer-group"></i></span>
                            <input asp-for="Name" class="form-control" placeholder="Kategori adını giriniz..." />
                        </div>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Açıklama -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Kategori ile ilgili detaylı açıklama giriniz..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-between align-items-center bg-light">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> İptal
                    </a>
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="fa-solid fa-rotate me-1"></i> Güncelle
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>