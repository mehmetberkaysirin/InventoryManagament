@model List<InventoryManagement.Application.DTOs.Stocks.StockListDto>

@{
    ViewData["Title"] = "Stoklar";
}

<div class="row">
    <div class="col-12">
        <div class="card card-outline card-primary shadow-sm">

            <div class="card-header d-flex align-items-center justify-content-between py-3">
                <h3 class="card-title fw-bold mb-0">
                    <i class="fa-solid fa-cubes me-2"></i>Stok Listesi
                </h3>
                <a asp-action="Create" class="btn btn-primary btn-sm px-3">
                    <i class="fa-solid fa-plus me-1"></i> Yeni Stok Ekle
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ürün Adı</th>
                                <th>Depo</th>
                                <th class="text-end pe-4">Miktar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.ProductName</td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                <i class="fa-solid fa-warehouse me-1"></i>@item.WarehouseName
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <span class="fw-bold fs-6 @(item.Quantity <= 5 ? "text-danger" : "text-dark")">
                                                @item.Quantity
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        <i class="fa-solid fa-inbox fs-3 d-block mb-2"></i>
                                        Henüz kaydedilmiş bir stok bulunamadı.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
