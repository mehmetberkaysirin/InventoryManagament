@model InventoryManagement.Web.ViewModels.Stocks.StockCreateViewModel

@{
    ViewData["Title"] = "Stok Ekle";
}

<div class="row">
    <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
        <div class="card card-primary card-outline shadow-sm">

            <div class="card-header">
                <h3 class="card-title fw-bold">
                    <i class="fa-solid fa-cubes me-2"></i>Yeni Stok Tanımı
                </h3>
            </div>

            <form asp-action="Create" method="post">
                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="ProductId" class="form-label fw-semibold">Ürün</label>
                        <select asp-for="ProductId"
                                asp-items="Model.Products"
                                class="form-select">
                            <option value="">-- Ürün Seçiniz --</option>
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WarehouseId" class="form-label fw-semibold">Depo</label>
                        <select asp-for="WarehouseId"
                                asp-items="Model.Warehouses"
                                class="form-select">
                            <option value="">-- Depo Seçiniz --</option>
                        </select>
                        <span asp-validation-for="WarehouseId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold">Miktar</label>
                        <div class="input-group">
                            <input asp-for="Quantity" class="form-control" placeholder="0" />
                            <span class="input-group-text">Adet</span>
                        </div>
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-between align-items-center bg-light">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> İptal
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-check me-1"></i> Kaydet
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>