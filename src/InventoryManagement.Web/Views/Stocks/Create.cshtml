@model InventoryManagement.Web.ViewModels.Stocks.StockCreateViewModel

<h2>Stok Ekle</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="ProductId" class="form-label">Ürün</label>
        <select asp-for="ProductId"
                asp-items="Model.Products"
                class="form-select">
            <option value="">Ürün Seçiniz</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="WarehouseId" class="form-label">Depo</label>
        <select asp-for="WarehouseId"
                asp-items="Model.Warehouses"
                class="form-select">
            <option value="">Depo Seçiniz</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">Miktar</label>
        <input asp-for="Quantity"
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Kaydet
    </button>

</form>