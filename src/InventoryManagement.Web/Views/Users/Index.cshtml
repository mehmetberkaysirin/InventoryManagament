@model IEnumerable<InventoryManagement.Web.Models.Account.UserListViewModel>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title fw-bold m-0"><i class="fa-solid fa-users me-2"></i>Kullanıcı Listesi</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm ms-auto">
            <i class="fa-solid fa-user-plus me-1"></i> Yeni Kullanıcı Ekle
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ad Soyad</th>
                        <th>E-Posta</th>
                        <th>Durum</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-bold">@user.FirstName @user.LastName</td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="fa-solid fa-xmark me-1"></i>Pasif</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-controller="Users" asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary me-1" title="Şifre Değiştir">
                                    <i class="fa-solid fa-key me-1"></i>Şifre Değiştir
                                </a>
                                <a asp-controller="Roles" asp-action="AssignRole" asp-route-userId="@user.Id" class="btn btn-sm btn-outline-info me-1">
                                    <i class="fa-solid fa-user-shield me-1"></i>Rol Ata
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                        <i class="fa-solid @(user.IsActive ? "fa-user-slash" : "fa-user-check") me-1"></i>
                                        @(user.IsActive ? "Pasife Al" : "Aktife Al")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>