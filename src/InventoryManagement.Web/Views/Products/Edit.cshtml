@model InventoryManagement.Web.ViewModels.Products.ProductUpdateViewModel

<h2>Ürün Düzenle</h2>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Ürün Adı</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Barcode" class="form-label">Barkod</label>
        <input asp-for="Barcode" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Kategori</label>
        <select asp-for="CategoryId"
                asp-items="Model.Categories"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="BrandId" class="form-label">Marka</label>
        <select asp-for="BrandId"
                asp-items="Model.Brands"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="UnitId" class="form-label">Birim</label>
        <select asp-for="UnitId"
                asp-items="Model.Units"
                class="form-select">
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Güncelle
    </button>

</form>