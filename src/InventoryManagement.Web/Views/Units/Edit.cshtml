@model InventoryManagement.Application.DTOs.Units.UnitUpdateDto

@{
    ViewData["Title"] = "Birim Düzenle";
}

<div class="row">
    <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
        <div class="card card-warning card-outline shadow-sm">

            <div class="card-header">
                <h3 class="card-title fw-bold">
                    <i class="fa-solid fa-pen-to-square me-2"></i>Birim Bilgilerini Güncelle
                </h3>
            </div>

            <form asp-action="Edit" method="post">
                <input asp-for="Id" type="hidden" />

                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Birim Adı</label>
                        <input asp-for="Name" class="form-control" placeholder="Örn: Kilogram, Litre, Adet" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ShortName" class="form-label fw-semibold">Kısa Ad (Sembol)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-ruler"></i></span>
                            <input asp-for="ShortName" class="form-control" placeholder="Örn: KG, LT, Ad" />
                        </div>
                        <span asp-validation-for="ShortName" class="text-danger"></span>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-between align-items-center bg-light">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> İptal
                    </a>
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="fa-solid fa-rotate me-1"></i> Güncelle
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>