@model InventoryManagement.Application.DTOs.Dashboard.DashboardSummaryDto

@{
    ViewData["Title"] = "Gösterge Paneli";

    // Lambda hatalarını kesin olarak önlemek için listeleri C# tarafında serileştiriyoruz
    var labelsJson = System.Text.Json.JsonSerializer.Serialize(Model.MonthlyMovements.Select(m => m.MonthName).ToList());
    var dataInJson = System.Text.Json.JsonSerializer.Serialize(Model.MonthlyMovements.Select(m => m.TotalIn).ToList());
    var dataOutJson = System.Text.Json.JsonSerializer.Serialize(Model.MonthlyMovements.Select(m => m.TotalOut).ToList());
}

<!-- Üst Metrik Kartları -->
<div class="row mb-4">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info shadow-sm">
            <div class="inner">
                <h3>@Model.TotalProductCount</h3>
                <p>Toplam Ürün Sayısı</p>
            </div>
            <div class="icon">
                <i class="fa-solid fa-box-open"></i>
            </div>
            <a asp-controller="Products" asp-action="Index" class="small-box-footer">
                Detaylar <i class="fa-solid fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-success shadow-sm">
            <div class="inner">
                <h3>@Model.TotalStockQuantity.ToString("N0")</h3>
                <p>Toplam Stok Miktarı</p>
            </div>
            <div class="icon">
                <i class="fa-solid fa-cubes"></i>
            </div>
            <a asp-controller="Stocks" asp-action="Index" class="small-box-footer">
                Detaylar <i class="fa-solid fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning shadow-sm">
            <div class="inner">
                <h3>@Model.TotalWarehouseCount</h3>
                <p>Aktif Depolar</p>
            </div>
            <div class="icon">
                <i class="fa-solid fa-warehouse"></i>
            </div>
            <a asp-controller="Warehouses" asp-action="Index" class="small-box-footer">
                Detaylar <i class="fa-solid fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger shadow-sm">
            <div class="inner">
                <h3>@Model.CriticalStockCount</h3>
                <p>Kritik Stok Uyarısı</p>
            </div>
            <div class="icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <a href="#critical-stocks" class="small-box-footer">
                İncele <i class="fa-solid fa-arrow-circle-down"></i>
            </a>
        </div>
    </div>
</div>

<!-- Grafik ve Kritik Stok Tablosu -->
<div class="row">
    <!-- Stok Hareket Grafiği -->
    <div class="col-lg-8">
        <div class="card card-outline card-primary shadow-sm mb-4">
            <div class="card-header">
                <h3 class="card-title fw-bold">
                    <i class="fa-solid fa-chart-line me-2"></i>Aylık Stok Giriş / Çıkış Trendi
                </h3>
            </div>
            <div class="card-body">
                <canvas id="movementChart" style="min-height: 300px; height: 300px; max-height: 300px; max-width: 100%;"></canvas>
            </div>
        </div>
    </div>

    <!-- Kritik Stok Listesi -->
    <div class="col-lg-4" id="critical-stocks">
        <div class="card card-outline card-danger shadow-sm mb-4">
            <div class="card-header">
                <h3 class="card-title fw-bold text-danger">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Kritik Seviyedeki Stoklar
                </h3>
            </div>
            <div class="card-body p-0">
                @if (Model.CriticalStocks != null && Model.CriticalStocks.Any())
                {
                    <table class="table table-striped table-valign-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th>Depo</th>
                                <th class="text-end">Miktar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stock in Model.CriticalStocks)
                            {
                                <tr>
                                    <td class="fw-semibold">@stock.ProductName</td>
                                    <td><span class="badge bg-secondary-subtle text-secondary">@stock.WarehouseName</span></td>
                                    <td class="text-end">
                                        <span class="badge bg-danger">@stock.CurrentQuantity.ToString("N0") Adet</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3 text-center text-muted">
                        <i class="fa-solid fa-check-circle text-success me-1"></i> Kritik seviyede ürün bulunmuyor.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js Kütüphanesi -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var labels = @Html.Raw(labelsJson);
            var dataIn = @Html.Raw(dataInJson);
            var dataOut = @Html.Raw(dataOutJson);

            var ctx = document.getElementById('movementChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Stok Girişi (+)',
                            backgroundColor: '#28a745',
                            borderColor: '#28a745',
                            data: dataIn
                        },
                        {
                            label: 'Stok Çıkışı (-)',
                            backgroundColor: '#dc3545',
                            borderColor: '#dc3545',
                            data: dataOut
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        });
    </script>
}