@using Microsoft.AspNetCore.Identity
@using InventoryManagement.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stok Yönetim Sistemi</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback" />
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- OverlayScrollbars -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.3.0/styles/overlayscrollbars.min.css" />
    <!-- AdminLTE 4 CSS -->
    <link rel="stylesheet" href="~/adminlte/dist/css/adminlte.min.css" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">

        <!-- NAVBAR START -->
        <nav class="app-header navbar navbar-expand bg-body shadow-sm">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="fa-solid fa-bars"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a asp-controller="Home" asp-action="Index" class="nav-link">
                            <i class="fa-solid fa-house me-1"></i> Ana Sayfa
                        </a>
                    </li>
                </ul>

                <!-- Top Right Menu -->
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="fullscreen" href="#" role="button">
                            <i class="fa-solid fa-expand"></i>
                        </a>
                    </li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var displayName = currentUser != null ? $"{currentUser.FirstName} {currentUser.LastName}".Trim() : User.Identity?.Name;
                        if (string.IsNullOrWhiteSpace(displayName))
                        {
                            displayName = User.Identity?.Name;
                        }

                        <!-- Kullanıcı Profil Menüsü -->
                        <li class="nav-item dropdown user-menu">
                            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-circle-user fa-lg me-1"></i>
                                <span class="d-none d-md-inline fw-bold">@displayName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                                <!-- User Header -->
                                <li class="user-header bg-primary text-white text-center p-3">
                                    <i class="fa-solid fa-circle-user fa-4x mb-2"></i>
                                    <p class="mb-0 fw-bold">@displayName</p>
                                    <small>@currentUser?.Email</small>
                                </li>
                                <!-- Menu Footer -->
                                <li class="user-footer p-2 bg-light d-flex justify-content-between align-items-center">
                                    <a asp-controller="Account" asp-action="Profile" class="btn btn-default btn-flat btn-sm border">Profilim</a>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-flat btn-sm">
                                            <i class="fa-solid fa-right-from-bracket me-1"></i> Çıkış Yap
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-primary btn-sm my-1" asp-controller="Account" asp-action="Login">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Giriş Yap
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
        <!-- NAVBAR END -->
        <!-- SIDEBAR START -->
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a asp-controller="Home" asp-action="Index" class="brand-link">
                    <i class="fa-solid fa-boxes-packing brand-image fs-4 me-2 ms-3 text-primary"></i>
                    <span class="brand-text fw-bold">Stok Yönetimi</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <!-- Gösterge Paneli -->
                            <li class="nav-item">
                                <a asp-controller="Home" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fa-solid fa-gauge-high"></i>
                                    <p>Gösterge Paneli</p>
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-header">SİSTEM</li>

                                <li class="nav-item">
                                    <a asp-controller="Users" asp-action="Index" class="nav-link">
                                        <i class="nav-icon fa-solid fa-users-gear"></i>
                                        <p>Kullanıcılar</p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a asp-controller="Roles" asp-action="Index" class="nav-link">
                                        <i class="nav-icon fa-solid fa-shield-halved"></i>
                                        <p>Rol Yönetimi</p>
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Admin") || User.IsInRole("WarehouseManager") || User.IsInRole("Depo Görevlisi"))
                            {
                                <li class="nav-header">TANIMLAMALAR</li>

                                <li class="nav-item">
                                    <a asp-controller="Categories" asp-action="Index" class="nav-link">
                                        <i class="nav-icon fa-solid fa-layer-group"></i>
                                        <p>Kategoriler</p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a asp-controller="Brands" asp-action="Index" class="nav-link">
                                        <i class="nav-icon fa-solid fa-copyright"></i>
                                        <p>Markalar</p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a asp-controller="Units" asp-action="Index" class="nav-link">
                                        <i class="nav-icon fa-solid fa-ruler"></i>
                                        <p>Birimler</p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a asp-controller="Warehouses" asp-action="Index" class="nav-link">
                                        <i class="nav-icon fa-solid fa-warehouse"></i>
                                        <p>Depolar</p>
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Admin") || User.IsInRole("WarehouseManager") || User.IsInRole("Depo Görevlisi") || User.IsInRole("User"))
                            {
                                <li class="nav-header">STOK İŞLEMLERİ</li>

                                <li class="nav-item">
                                    <a asp-controller="Products" asp-action="Index" class="nav-link">
                                        <i class="nav-icon fa-solid fa-boxes-stacked"></i>
                                        <p>Ürünler</p>
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Admin") || User.IsInRole("WarehouseManager") || User.IsInRole("Depo Görevlisi"))
                            {
                                <li class="nav-item">
                                    <a asp-controller="Stocks" asp-action="Index" class="nav-link">
                                        <i class="nav-icon fa-solid fa-cubes"></i>
                                        <p>Stok Durumu</p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a asp-controller="StockMovements" asp-action="Index" class="nav-link">
                                        <i class="nav-icon fa-solid fa-arrow-right-left"></i>
                                        <p>Stok Hareketleri</p>
                                    </a>
                                </li>
                            }
                        }

                    </ul>
                </nav>
            </div>
        </aside>
        <!-- SIDEBAR END -->
        <!-- MAIN CONTENT START -->
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row align-items-center">
                        <div class="col-sm-6">
                            <h3 class="mb-0 fw-bold">@ViewData["Title"]</h3>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-end mb-0">
                                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
            <div class="app-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </main>
        <!-- MAIN CONTENT END -->
        <!-- FOOTER START -->
        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">
                <b>Sürüm</b> 1.0.0
            </div>
            <strong>&copy; 2026 - <a href="#" class="text-decoration-none">Stok Yönetim Sistemi</a>.</strong> Tüm hakları saklıdır.
        </footer>
        <!-- FOOTER END -->

    </div>

    <!-- REQUIRED SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.3.0/browser/overlayscrollbars.browser.es6.zm.js"></script>

    <!-- SignalR CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
            // Burası küçük harfle 'signalr' olarak düzeltildi
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/stockHub")
                .build();

            connection.on("ReceiveStockUpdate", function () {
                console.log("Stok güncellendi, liste yenileniyor...");
                location.reload();
            });

            connection.start().catch(function (err) {
                return console.error("SignalR Bağlantı Hatası: ", err.toString());
            });
    </script>

    <script src="~/adminlte/dist/js/adminlte.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>