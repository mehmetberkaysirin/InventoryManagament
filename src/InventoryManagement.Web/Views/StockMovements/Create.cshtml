@model InventoryManagement.Web.ViewModels.StockMovements.StockMovementCreateViewModel

@{
    ViewData["Title"] = "Stok Hareketi Ekle";
}

<div class="row">
    <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
        <div class="card card-primary card-outline shadow-sm">

            <div class="card-header">
                <h3 class="card-title fw-bold">
                    <i class="fa-solid fa-arrow-right-left me-2"></i>Yeni Stok Hareketi
                </h3>
            </div>

            <form asp-action="Create" method="post">
                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="StockId" class="form-label fw-semibold">Stok (Ürün - Depo)</label>
                        <select asp-for="StockId"
                                asp-items="Model.Stocks"
                                class="form-select">
                            <option value="">-- Stok Seçiniz --</option>
                        </select>
                        <span asp-validation-for="StockId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MovementType" class="form-label fw-semibold">Hareket Türü</label>
                        <select asp-for="MovementType" class="form-select">
                            <option value="">-- Hareket Türü Seçiniz --</option>
                            <option value="1">Giriş (+)</option>
                            <option value="2">Çıkış (-)</option>
                            <option value="3">Transfer Giriş</option>
                            <option value="4">Transfer Çıkış</option>
                            <option value="5">Sayım Düzeltme</option>
                        </select>
                        <span asp-validation-for="MovementType" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold">Miktar</label>
                        <div class="input-group">
                            <input asp-for="Quantity" class="form-control" placeholder="0.00" />
                            <span class="input-group-text">Adet</span>
                        </div>
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Hareket detayını veya açıklamasını giriniz..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-between align-items-center bg-light">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> İptal
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-check me-1"></i> Kaydet
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
