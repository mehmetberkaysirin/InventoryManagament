@model IEnumerable<InventoryManagement.Application.DTOs.StockMovements.StockMovementListDto>

@{
    ViewData["Title"] = "Stok Hareketleri";
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title fw-bold mb-0">Stok Hareket Geçmişi</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm ms-auto">
            <i class="fa-solid fa-plus me-1"></i> Yeni Hareket Ekle
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Ürün Adı</th>
                    <th>Depo</th>
                    <th>Hareket Türü</th>
                    <th class="text-end">Miktar</th>
                    <th class="text-end">İşlem Tarihi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    // MovementType string olduğu için string karşılaştırması yapıyoruz
                    string type = item.MovementType?.ToString() ?? "";

                    bool isPositive = type == "Entry" || type == "TransferIn" || type == "Stok Girişi";
                    bool isNegative = type == "Exit" || type == "TransferOut" || type == "Stok Çıkışı";

                    var displayQuantity = Math.Abs(item.Quantity);

                    <tr>
                        <td class="fw-semibold">@item.ProductName</td>
                        <td>
                            <span class="badge bg-secondary-subtle text-secondary">
                                <i class="fa-solid fa-warehouse me-1"></i>@item.WarehouseName
                            </span>
                        </td>
                        <td>
                            @if (type == "Entry" || type == "Stok Girişi")
                            {
                                <span class="badge bg-success-subtle text-success">Stok Girişi</span>
                            }
                            else if (type == "TransferIn")
                            {
                                <span class="badge bg-info-subtle text-info">Transfer Giriş</span>
                            }
                            else if (type == "Exit" || type == "Stok Çıkışı")
                            {
                                <span class="badge bg-danger-subtle text-danger">Stok Çıkışı</span>
                            }
                            else if (type == "TransferOut")
                            {
                                <span class="badge bg-warning-subtle text-warning">Transfer Çıkış</span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary">@item.MovementType</span>
                            }
                        </td>
                        <td class="text-end fw-bold">
                            @if (isPositive)
                            {
                                <span class="text-success">+@displayQuantity.ToString("N2")</span>
                            }
                            else if (isNegative)
                            {
                                <span class="text-danger">-@displayQuantity.ToString("N2")</span>
                            }
                            else
                            {
                                <span class="text-primary">@displayQuantity.ToString("N2")</span>
                            }
                        </td>
                        <td class="text-end text-muted">
                            <i class="fa-regular fa-clock me-1"></i>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>